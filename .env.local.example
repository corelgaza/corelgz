# Salin ke .env.local lalu isi dari Supabase Dashboard

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon_key...

SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key...

# Untuk npm run db:setup (pilih salah satu):
# SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_DB_PASSWORD=password_database_anda

# Opsional setelah deploy:
# NEXT_PUBLIC_SITE_URL=https://nama-project.vercel.app
