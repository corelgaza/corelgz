# Salin ke .env.local lalu isi dari Supabase Dashboard

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon_key...

SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key...

# Untuk npm run db:setup (pilih salah satu):
# SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_DB_PASSWORD=password_database_anda

# Opsional setelah deploy:
# NEXT_PUBLIC_SITE_URL=https://nama-project.vercel.app

# Admin dashboard (/admin)
# ADMIN_PASSWORD: password untuk login admin (string apa saja, minimal 12 karakter)
# ADMIN_SESSION_SECRET: secret untuk sign cookie session (acak 32+ karakter, generate misal dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_PASSWORD=ganti_dengan_password_admin_anda
ADMIN_SESSION_SECRET=ganti_dengan_string_acak_minimal_32_karakter_panjang_aman
